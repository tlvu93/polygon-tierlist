{
  "name": "@your-org/file-explorer",
  "version": "1.0.0",
  "description": "A reusable file and folder management component with drag and drop functionality",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "file-explorer",
    "file-manager",
    "drag-drop",
    "typescript",
    "component-library"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/react": "^10.3.4",
    "@storybook/react-vite": "^10.3.4",
    "@testing-library/dom": "^10.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "storybook": "^10.3.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/file-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/file-explorer/issues"
  },
  "homepage": "https://github.com/your-org/file-explorer#readme"
}
